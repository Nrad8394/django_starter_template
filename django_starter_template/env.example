# =============================================================================
# Environment configuration
#
#   cp env.example .env
#
# .env is gitignored. Never commit real credentials — see the SECRETS section
# at the bottom for how to handle them in deployed environments.
#
# Every variable here is read through apps' settings modules via the helpers
# in settingsConfig/env.py. A variable that is not read there does nothing.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Selects the settings profile: development | test | production.
# NOTE: this is NOT DJANGO_SETTINGS_MODULE, which always stays pointed at
# `<project>.settings`. See the docstring in settings.py for why.
DJANGO_ENV=development

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Production refuses to start with the development placeholder.
SECRET_KEY=django-insecure-CHANGE-ME-BEFORE-DEPLOYING

DEBUG=True

# Comma-separated. Must include every hostname the app is served on.
# A missing entry here presents as a confusing 400 "Invalid HTTP_HOST header".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

SITE_NAME=Starter Template
SITE_DOMAIN=localhost:8000
# Used to build absolute links in emails. Must be reachable by the recipient —
# "localhost" in a production email is a broken link.
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# A single DATABASE_URL is preferred; it is what every PaaS provides and it
# keeps credentials in one place. The discrete POSTGRES_* vars below are for
# docker-compose, which needs them separately to initialise the container.
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/app_db

POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Seconds to keep a database connection open for reuse. 0 opens a new
# connection per request — fine locally, wasteful under load. Keep this
# BELOW your database's idle timeout and below any connection pooler's, or
# you hand out connections the server has already closed.
DB_CONN_MAX_AGE=60

# Wrap every request in a transaction. Strong consistency guarantee; costs a
# held transaction for the whole request, including slow external calls.
# Leave off unless you know you want it.
DB_ATOMIC_REQUESTS=False

# -----------------------------------------------------------------------------
# Cache / Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
CACHE_TIMEOUT=300

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
# Run tasks inline instead of dispatching them. Useful in tests; catastrophic
# in production, where it makes every request wait for its background work.
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_WORKER_CONCURRENCY=4

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_VERSION=1.0.0
DRF_PAGE_SIZE=20
DRF_THROTTLE_ANON_RATE=100/hour
DRF_THROTTLE_USER_RATE=2000/hour
DRF_THROTTLE_BURST_RATE=30/minute
DRF_THROTTLE_LOGIN_RATE=10/minute

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Exact origins, including scheme and port. No trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True
# Never set this True with CORS_ALLOW_CREDENTIALS=True. The combination is
# rejected by browsers, and where it is not, it means any site can make
# authenticated requests as your users. Production settings refuse it.
CORS_ALLOW_ALL_ORIGINS=False

# Required by Django >= 4 for any cross-origin POST to a session-auth view
# (the admin behind a proxy, for instance). Needs the scheme.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Short access lifetime, longer refresh. The access token cannot be revoked
# before it expires, so its lifetime is your worst-case exposure window after
# a token leaks — minutes, not hours.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Issue a new refresh token on each use and blacklist the old one. Turns
# refresh-token theft into a detectable event (the legitimate client's next
# refresh fails). Requires `token_blacklist` in INSTALLED_APPS.
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# -----------------------------------------------------------------------------
# Security (production settings enforce stricter values regardless)
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
# Start at 0. Once you are certain every subdomain is HTTPS-only, raise to
# 3600, then 31536000. HSTS is hard to undo: browsers cache it for the full
# max-age and will refuse plain HTTP to your domain until it expires.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=1209600
X_FRAME_OPTIONS=DENY

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Development default prints to the console. Switch to the SMTP backend when
# you want to see real delivery:
#   django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# local | s3 | minio
STORAGE_BACKEND=local
MEDIA_URL=/media/
STATIC_URL=/static/

# S3 / MinIO. AWS_S3_ENDPOINT_URL is only needed for MinIO or another
# S3-compatible service; leave blank for real AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
# False keeps objects private and serves them via time-limited signed URLs.
# True makes every uploaded file world-readable by URL — only for genuinely
# public assets.
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600

# -----------------------------------------------------------------------------
# Internationalization
# -----------------------------------------------------------------------------
LANGUAGE_CODE=en-us
# Keep the server in UTC and convert for display. Storing local time is how
# you get an hour of duplicated or missing records twice a year.
TIME_ZONE=UTC
USE_I18N=True
USE_TZ=True

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# json for aggregators (Loki, CloudWatch, Datadog); console for humans.
LOG_FORMAT=console
# Requests slower than this are logged at WARNING.
SLOW_REQUEST_THRESHOLD_SECONDS=1.0

# -----------------------------------------------------------------------------
# Error tracking (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Fraction of requests traced. 1.0 in development, 0.05–0.2 in production —
# tracing every request in a high-traffic service is expensive and rarely
# more informative than a sample.
SENTRY_TRACES_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# Social authentication (optional)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Gunicorn (read by the Docker entrypoint)
# -----------------------------------------------------------------------------
# Blank means "compute from CPU count at container start" — keeps one image
# usable across differently-sized hosts.
GUNICORN_WORKERS=
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# =============================================================================
# SECRETS
#
# This file documents shape, not values. For anything deployed:
#
#   * Inject secrets from your platform's secret store (AWS Secrets Manager,
#     GCP Secret Manager, Vault, Kubernetes Secrets, the hosting provider's
#     environment settings) rather than shipping a .env file.
#   * A .env on a server is a file on disk: it survives in backups, appears in
#     `docker inspect`, and is readable by anything that can read the
#     filesystem. That is acceptable for a hobby deployment and not for
#     production.
#   * Rotate SECRET_KEY and you invalidate every session and every signed
#     value (password-reset links, email-confirmation tokens). Plan for it.
# =============================================================================
